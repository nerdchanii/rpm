{
  "version": 3,
  "repository": "nerdchanii/rpm",
  "execution_queue": {
    "source": "issue-labels",
    "open_issues_only": true,
    "order": "issue-number-ascending",
    "active_states": [
      "claimed",
      "review-pending"
    ]
  },
  "project": {
    "owner": "@me",
    "number": 7,
    "role": "local-roadmap",
    "required_for_execution": false
  },
  "labels": {
    "research": "agent:research",
    "ready": "agent:ready",
    "claimed": "agent:claimed",
    "review-pending": "agent:review-pending",
    "awaiting-merge": "agent:awaiting-merge",
    "blocked": "agent:blocked"
  },
  "batch_limits": {
    "research": 1,
    "execution": 1
  },
  "issue_body": {
    "managed_section_start": "<!-- rpm-agent-research:start -->",
    "managed_section_end": "<!-- rpm-agent-research:end -->"
  },
  "allowed_transitions": {
    "untracked": [
      "research"
    ],
    "research": [
      "research",
      "ready",
      "blocked"
    ],
    "ready": [
      "claimed",
      "blocked"
    ],
    "claimed": [
      "ready",
      "review-pending",
      "blocked"
    ],
    "review-pending": [
      "review-pending",
      "awaiting-merge",
      "blocked"
    ],
    "awaiting-merge": [
      "blocked"
    ],
    "blocked": [
      "research",
      "ready"
    ]
  },
  "automation": {
    "create_followup_issues_by_default": false,
    "merge_pull_requests": false,
    "request_codex_review": false
  },
  "merge_gate": {
    "enabled": true,
    "source_state": "awaiting-merge",
    "order": "issue-number-ascending",
    "batch_limit": 1,
    "required_checks": [
      "metadata",
      "verify"
    ],
    "required_mergeable": true,
    "forbid_unresolved_p0_p1": true,
    "method": "squash",
    "delete_branch": true
  }
}
