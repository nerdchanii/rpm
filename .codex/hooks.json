{
  "description": "RPM workflow role boundaries and per-issue completion gates.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(rpm_|pr-review-resolver$)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/agent_tool_policy.py\"",
            "timeout": 10,
            "statusMessage": "Registering RPM agent policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|apply_patch|Edit|Write|Bash|shell|exec|exec_command|functions\\.exec|functions\\.exec_command|mcp__.*|.*([Cc][Aa][Ll][Ll]|[Dd][Ii][Ss][Pp][Aa][Tt][Cc][Hh]|[Dd][Ii][Ss][Pp][Aa][Tt][Cc][Hh][Ee][Rr]|[Ee][Xx][Ee][Cc][Uu][Tt][Ee]|[Ee][Xx][Ee][Cc][Uu][Tt][Oo][Rr]|[Ii][Nn][Vv][Oo][Kk][Ee]|[Rr][Ee][Qq][Uu][Ee][Ss][Tt]|[Rr][Uu][Nn]).*|.*([Bb][Aa][Ss][Hh]|[Ss][Hh][Ee][Ll][Ll]|[Tt][Ee][Rr][Mm][Ii][Nn][Aa][Ll])$|.*([Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Hh]_|[Ii][Ss][Ss][Uu][Ee]|[Pp][Uu][Ll][Ll].?[Rr][Ee][Qq][Uu][Ee][Ss][Tt]|[Pp][Rr]_|[Pp][Rr][Oo][Jj][Ee][Cc][Tt]|[Ll][Aa][Bb][Ee][Ll]|[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Oo][Rr]|[Dd][Ii][Ss][Pp][Aa][Tt][Cc][Hh][Ee][Rr]|[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr]|[Aa][Pp][Ii]|[Hh][Oo][Ss][Tt]).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/agent_tool_policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking RPM agent tool boundary"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(rpm_|pr-review-resolver$)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/agent_tool_policy.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^rpm_issue_manager$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/issue_manager_stop_gate.py\"",
            "timeout": 1800,
            "statusMessage": "Verifying completed RPM issue workflow"
          }
        ]
      }
    ]
  }
}
